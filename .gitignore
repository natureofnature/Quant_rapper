.venv/
__pycache__/
*.egg-info/
dist/

# Generated research-map previews
/knowledge_base/prior_knowledge/Relationships/**/*.html
/knowledge_base/math/methods.html

# run outputs: keep the folders, ignore their contents
run/**

# The daily loop's working files: logs, locks and scratch. Tickets and snapshots it produces go under artifacts/.
/monitors/Daily/**
artifacts/**
!artifacts/**/
!artifacts/**/.gitkeep

# Reusable snapshot metadata and curated source data
!/artifacts/snapshots/*/manifest.json
!/artifacts/snapshots/2026-11-21/tsmc_monthly_revenue_events.json
!/artifacts/snapshots/2026-11-21/us_equity_sessions_2026.json
!/artifacts/snapshots/2026-11-22/tsmc_monthly_revenue_events.json
!/artifacts/snapshots/2026-11-22/us_equity_sessions_2002_2026.json
!/artifacts/snapshots/2026-11-22/tsmc_monthly_revenue_figures.json
!/artifacts/snapshots/2026-11-22/tsmc_monthly_revenue_first_release.json
!/artifacts/snapshots/2026-11-22/announcement_dates_2002_2026.json
!/artifacts/snapshots/2026-11-22/tsmc_quarterly_guidance.json
!/artifacts/snapshots/2026-11-22/treasury_real_yield_10y.csv
!/artifacts/snapshots/2026-11-22/us_treasury_yield_sessions_2003_2026.json

# Causal maps: curated source packets, the generator's outputs and the evaluator hand-off
!/artifacts/causal_maps/
!/artifacts/causal_maps/*/
!/artifacts/causal_maps/*/packet.json
!/artifacts/causal_maps/*/monthly_periods_*.json
!/artifacts/causal_maps/*/evaluate.py
!/artifacts/causal_maps/*/output/
!/artifacts/causal_maps/*/output/*/
!/artifacts/causal_maps/*/output/*/causal_map.json
!/artifacts/causal_maps/*/output/*/recipes.json
!/artifacts/causal_maps/*/output/*/table.json
!/artifacts/causal_maps/*/output/*/gap.json

# Forecast tickets and their matured outcomes: written once by the post-market loop
!/artifacts/tickets/
!/artifacts/tickets/*/
!/artifacts/tickets/*/*.json
!/artifacts/tickets/*/outcomes/
!/artifacts/tickets/*/outcomes/*.json

# Prospective registrations: the recipe and what was fixed before the events
!/artifacts/prospective/*/registration.json
!/artifacts/prospective/*/recipe.json
!/artifacts/prospective/*/record_event.py
!/artifacts/prospective/*/rows/
!/artifacts/prospective/*/rows/*.json
!/artifacts/ablations/*/registration.json
!/artifacts/ablations/*/run.py
!/artifacts/ablations/*/coverage.py
!/artifacts/ablations/*/coverage.json
!/artifacts/ablations/*/report.py
!/artifacts/ablations/*/frozen.json
!/artifacts/ablations/*/output/
!/artifacts/ablations/*/output/report.json
!/artifacts/ablations/*/output/report.md
!/artifacts/ablations/*/output/positions_*.csv
!/artifacts/ablations/*/output/shocks.csv
!/artifacts/ablations/*/output/events.csv
!/artifacts/ablations/*/output/surprise.csv
