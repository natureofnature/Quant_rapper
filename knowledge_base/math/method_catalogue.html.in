<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>量化方法 · Quantitative methods</title>
<style>
*{box-sizing:border-box} :root{color-scheme:light;--ink:#172c34;--green:#116450;--line:#cedbd6}
body{margin:0;background:#f5f7f5;color:var(--ink);font:16px/1.55 "Source Sans 3",system-ui,sans-serif}
header,main{max-width:1550px;margin:auto;padding:18px clamp(14px,4vw,64px)}
header{display:flex;align-items:center;justify-content:space-between;gap:15px;border-bottom:1px solid var(--line)}
h1,h2,h3,p{margin:0 0 .6em} h1{font-size:clamp(26px,3vw,40px);letter-spacing:-.04em}h1 small{font-size:.49em;color:#456258;letter-spacing:0}
input,select,button{font:inherit;color:inherit} input,select,.switch button{padding:8px 12px;border:1px solid #afc2ba;border-radius:6px;background:white}
.toolbar,.switch{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.toolbar{margin-bottom:16px}.toolbar input{min-width:min(260px,100%);flex:1}
button,a{cursor:pointer}a{color:var(--green);text-underline-offset:3px}.switch button[aria-pressed=true]{background:var(--green);color:white}
#allEdgesControl{display:inline-flex;align-items:center;gap:6px}#allEdges{min-width:0;width:1em;height:1em;accent-color:var(--green)}
.workspace{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,1fr);gap:20px;align-items:start}
.pane,aside{background:white;border:1px solid var(--line);border-radius:10px;padding:18px;max-height:calc(100vh - 183px);overflow:auto}
#list h2{font-size:17px;letter-spacing:.015em;margin-top:22px;color:var(--green)}#list h2:first-child{margin-top:6px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(210px,100%),1fr));gap:6px}
.entry{display:block;padding:8px 10px;text-decoration:none;color:var(--ink);border:1px solid transparent;border-radius:5px;line-height:1.35}
.entry:hover,.entry[aria-current=true]{background:#edf6ef;border-color:#c2d9ca}.entry span,.secondary{display:block;color:#50675f;font-size:14px}
aside h2{font-size:25px;line-height:1.3}aside h3{font-size:16px;margin-top:18px;color:#365b50}aside ul{padding-left:22px;margin:.3em 0}
aside{overflow-wrap:anywhere}.relation{background:#f2f7f4;border:1px solid var(--line);border-radius:5px;color:var(--green);margin:2px 8px 2px 0;padding:2px 7px}
#count{font-variant-numeric:tabular-nums;margin:0 0 8px;color:#53675f}
[hidden]{display:none!important} #diagram{overflow:auto}#diagram svg{display:block;width:100%;height:auto}
svg text{font-family:inherit;fill:var(--ink)}.wedge{opacity:.06}.tree,.guide,.line,.hit{fill:none}.tree{opacity:.35}.guide{stroke:#aab9b2;stroke-dasharray:3 5}
.rel .line{opacity:.38;stroke-width:1.8}.rel .hit{stroke:transparent;stroke-width:12;cursor:pointer}.rel text{display:none}.rel.active .line{opacity:1;stroke-width:3}
svg.norel .rel:not(.active){display:none}
svg.focus .node:not(.active),svg.focus .branch:not(.active){opacity:.28}svg.focus .tree{opacity:.1}
svg .node.active text{font-weight:600}svg .node.picked circle,.branch.picked rect{stroke:var(--ink);stroke-width:4}
.rel.picked text,.rel:hover text,.rel:focus-visible text{display:block;font-size:18px;font-weight:700;paint-order:stroke;stroke:white;stroke-width:5;pointer-events:none}
svg .entity{font-size:16px}svg .branch text{fill:white;font-weight:600;font-size:18px}.root circle{fill:white;stroke:var(--line)}.root text{font-size:20px}
svg .node,svg .branch{cursor:pointer}svg .node.active text{fill:var(--green);font-weight:bold}.node.active circle{stroke:var(--green);stroke-width:4}
@media(max-width:800px){header{flex-wrap:wrap}.workspace{grid-template-columns:1fr}.pane{max-height:46vh}aside{max-height:none}h1 small{display:block}.toolbar .switch{flex-basis:100%}}
</style></head><body>
<header><h1>量化方法 <small>Quantitative methods</small></h1><select id="maps" aria-label="知识地图"></select></header>
<main><div class="toolbar"><input id="search" type="search" aria-label="搜索方法" placeholder="搜索方法、英文缩写或 ID">
<select id="category" aria-label="方法分类"><option value="">所有分类</option></select>
<div class="switch"><button id="browse" aria-pressed="true">速查目录</button><button id="draw" aria-pressed="false">关系图</button>
<button id="zoom" hidden aria-pressed="false">放大图谱</button><button id="overview" hidden>总览</button>
<label id="allEdgesControl" hidden><input id="allEdges" type="checkbox"> 显示全部连线</label></div></div>
<div class="workspace"><div class="pane"><p id="count" aria-live="polite"></p><div id="list"></div><div id="diagram" hidden>__GRAPH__</div></div>
<aside id="detail" aria-label="条目详情"></aside></div></main>
<script type="application/json" id="payload">__DATA__</script>
<script>
const {entries,maps,families}=JSON.parse(document.querySelector('#payload').textContent);
const el=id=>document.getElementById(id);
const groups={feature:'信号与特征',labeling:'训练标签',predictor:'预测模型',risk:'风险度量',portfolio:'组合与仓位',
  valuation:'衍生品定价',strategy:'策略构造',optimizer:'数值优化',evaluation:'验证与回测',execution:'交易执行',tools:'工具',experiences:'研究实例',subjects:'关联标的'};
const all=Object.values(entries), categories=[...new Set([...Object.keys(groups),...all.map(e=>e.category)])].filter(k=>all.some(e=>e.category===k));
const edges=all.flatMap(e=>e.links.map(link=>({from:e.id,to:link.target,relation:link.relation})));
const relationNames={implements:'实现',supports:'支持',extends:'扩展自',uses_method:'使用方法',can_use:'可选方法',
  uses_label:'使用标签',uses_predictor:'使用预测器',uses_tool:'使用工具',studied_on:'研究标的'};
const relationName=edge=>relationNames[edge.relation]||edge.relation.replaceAll('_',' ');
const family=e=>families[e.category]||e.category;
const name=e=>e.name_zh||e.name;
const graph=el('diagram').querySelector('svg');
function element(tag,text,parent){const obj=document.createElement(tag);if(text)obj.textContent=text;parent.append(obj);return obj}
function link(text,href,parent){const a=element('a',text,parent);a.href=href;return a}
function entryLink(e,parent){return link(name(e),'#'+encodeURIComponent(e.id),parent)}
for(const item of maps)el('maps').add(new Option(item.label,item.href,item.current,item.current));
el('maps').onchange=()=>location.assign(el('maps').value);
for(const k of categories)el('category').add(new Option(groups[k]||k,k));
let selected='';
function browse(){
  const q=el('search').value.trim().toLowerCase(), cat=el('category').value;
  const filtered=all.filter(e=>(!cat||cat===e.category)&&[e.name,e.name_zh,e.id,e.description,...(e.aliases||[])].join(' ').toLowerCase().includes(q));
  const list=el('list');list.replaceChildren();
  el('count').textContent=filtered.length+' / '+all.length+' 条目';
  for(const k of categories){
    const rows=filtered.filter(e=>e.category===k).sort((a,b)=>a.name.localeCompare(b.name));
    if(!rows.length)continue;
    element('h2',groups[k]||k,list);const grid=element('div','',list);grid.className='grid';
    for(const e of rows){const a=entryLink(e,grid);a.className='entry';a.dataset.id=e.id;
      if(e.name_zh)element('span',e.name,a);a.setAttribute('aria-current',String(e.id===selected));}
  }
  if(!filtered.length)element('p','没有匹配的条目。',list);
}
function highlight(ids,links,picked=null){
  const nodes=new Set(ids), relations=new Set(links);
  for(const edge of links){nodes.add(edge.from);nodes.add(edge.to)}
  const branches=new Set([...nodes].map(id=>family(entries[id])));
  graph.classList.toggle('focus',nodes.size>0);
  for(const n of graph.querySelectorAll('[data-n]'))n.classList.toggle('active',nodes.has(n.dataset.n));
  for(const b of graph.querySelectorAll('[data-b]'))b.classList.toggle('active',branches.has(b.dataset.b));
  for(const line of graph.querySelectorAll('[data-e]'))line.classList.toggle('active',relations.has(edges[Number(line.dataset.e)]));
  graph.querySelector('.picked')?.classList.remove('picked');
  picked?.classList.add('picked');
}
function panelFor(title){
  const panel=el('detail');panel.replaceChildren();panel.scrollTop=0;
  element('h2',title,panel);return panel;
}
function relationButton(edge,parent){
  const button=element('button',relationName(edge),parent);
  button.className='relation';button.title=name(entries[edge.from])+' → '+name(entries[edge.to]);
  button.onclick=()=>{switchView(true);showEdge(edge)};
}
function showEdge(edge){
  const panel=panelFor(relationName(edge));
  element('p',edge.relation,panel).className='secondary';
  entryLink(entries[edge.from],panel);panel.append(' → ');entryLink(entries[edge.to],panel);
  highlight([], [edge],graph.querySelector('[data-e="'+edges.indexOf(edge)+'"]'));
}
function showBranch(key){
  const members=all.filter(e=>family(e)===key), ids=new Set(members.map(e=>e.id));
  const links=edges.filter(edge=>ids.has(edge.from)||ids.has(edge.to));
  const panel=panelFor(key);element('h3','条目 · '+members.length,panel);
  const membersList=element('ul','',panel);
  for(const e of members)entryLink(e,element('li','',membersList));
  element('h3','关联 · '+links.length,panel);
  const linkList=element('ul','',panel);
  for(const edge of links){const row=element('li','',linkList);relationButton(edge,row);
    entryLink(entries[edge.from],row);row.append(' → ');entryLink(entries[edge.to],row)}
  highlight(ids,links,graph.querySelector('[data-b="'+CSS.escape(key)+'"]'));
}
function showOverview(){
  history.replaceState(null,'',location.pathname+location.search);
  highlight([],[]);
  const panel=panelFor('方法关系图');
  element('p','选择方法或分类查看与之相连的条目，点击箭头查看关系方向。',panel);
  for(const key of new Set(all.map(family))){
    const button=element('button',key,panel);button.className='relation';button.onclick=()=>showBranch(key);
  }
}
function detail(){
  const raw=location.hash.slice(1);let key;try{key=decodeURIComponent(raw)}catch{key=''}
  const e=Object.hasOwn(entries,key)?entries[key]:(entries['label:triple_barrier']||all[0]);
  selected=e.id;const panel=panelFor(name(e));
  element('p',[e.name_zh?e.name:'',e.id].filter(Boolean).join(' · '),panel).className='secondary';
  element('p',e.description,panel);
  function section(title,items){if(items?.length){element('h3',title,panel);const ul=element('ul','',panel);for(const txt of items)element('li',txt,ul)}}
  section('别名',e.aliases);section('输入',e.inputs);section('标签取值',e.outcomes);section('使用说明',[e.usage,e.status,e.features,e.label,e.prediction,e.finding].filter(Boolean));
  const outgoing=edges.filter(edge=>edge.from===e.id),incoming=edges.filter(edge=>edge.to===e.id);
  function relations(title,links,inbound){if(!links.length)return;element('h3',title,panel);const ul=element('ul','',panel);
    for(const edge of links){const li=element('li','',ul);relationButton(edge,li);li.append(inbound?' ← ':' → ');
      entryLink(entries[inbound?edge.from:edge.to],li)}}
  relations('引用与依赖',outgoing,false);
  relations('被哪些条目引用',incoming,true);
  if(!outgoing.length&&!incoming.length)element('p','该条目尚无已记录的直接关系。',panel).className='secondary';
  if(e.repository_example){element('h3','仓库实现或研究样例',panel);link(e.repository_example,'../../'+e.repository_example,panel)}
  if(e.market_page){element('h3','市场地图',panel);link(e.name,e.market_page,panel)}
  element('h3','来源',panel);const sources=element('ul','',panel);
  link('条目 JSON',e.file,element('li','',sources));
  for(const s of new Set([...(e.sources||[]),e.feature_registration].filter(Boolean))){
    if(s===e.repository_example)continue;const external=s.startsWith('https://');
    link(external?new URL(s).hostname:s,external?s:'../../'+s,element('li','',sources));}
  document.querySelectorAll('.entry').forEach(a=>a.setAttribute('aria-current',String(a.dataset.id===e.id)));
  highlight([e.id],[...outgoing,...incoming],graph.querySelector('[data-n="'+CSS.escape(e.id)+'"]'));
}
function switchView(drawing){
  el('list').hidden=drawing;el('diagram').hidden=!drawing;
  el('browse').setAttribute('aria-pressed',String(!drawing));el('draw').setAttribute('aria-pressed',String(drawing));
  el('count').hidden=drawing;
  el('search').hidden=el('category').hidden=drawing;
  el('zoom').hidden=el('overview').hidden=el('allEdgesControl').hidden=!drawing;
  if(drawing){const b=graph.getBBox();graph.setAttribute('viewBox',[b.x-20,b.y-20,b.width+40,b.height+40].join(' '))}
}
el('browse').onclick=()=>{switchView(false);detail()};
el('draw').onclick=()=>{switchView(true);if(location.hash)detail();else showOverview()};
el('allEdges').onchange=()=>graph.classList.toggle('norel',!el('allEdges').checked);
el('overview').onclick=showOverview;
el('zoom').onclick=()=>{const large=el('zoom').getAttribute('aria-pressed')!=='true';
  graph.style.width=large?'max(1600px, 160%)':'100%';el('zoom').setAttribute('aria-pressed',String(large));el('zoom').textContent=large?'适应宽度':'放大图谱'};
el('search').oninput=el('category').onchange=()=>{switchView(false);browse()};
graph.onclick=event=>{
  const n=event.target.closest('[data-n]'),b=event.target.closest('[data-b]'),line=event.target.closest('[data-e]');
  if(n?.dataset.n){const hash='#'+encodeURIComponent(n.dataset.n);if(hash===location.hash)detail();else location.hash=hash}
  else if(line)showEdge(edges[Number(line.dataset.e)]);
  else if(b)showBranch(b.dataset.b);
  else showOverview();
};
for(const item of graph.querySelectorAll('[data-n],[data-b],[data-e]')){
  item.setAttribute('role','button');item.setAttribute('tabindex','0');
  const edge=edges[item.dataset.e];
  const label=edge?name(entries[edge.from])+' → '+relationName(edge)+' → '+name(entries[edge.to]):
    (item.dataset.b||(item.dataset.n?name(entries[item.dataset.n]):'总览'));
  item.setAttribute('aria-label',label);
}
graph.onkeydown=event=>{if((event.key==='Enter'||event.key===' ')&&event.target.matches('[role=button]')){
  event.preventDefault();event.target.dispatchEvent(new MouseEvent('click',{bubbles:true}))}};
document.addEventListener('click',event=>{const a=event.target.closest('a[href^="#"]');if(a && a.hash===location.hash)detail()});
window.addEventListener('hashchange',detail);browse();detail();
</script></body></html>
